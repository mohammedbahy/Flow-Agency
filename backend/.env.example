# ------------------------------------------------------------------
# Backend environment template — copy to `.env`, never commit `.env`.
#   cp backend/.env.example backend/.env
# ------------------------------------------------------------------

# Port the NestJS API listens on
PORT=3000
BACKEND_PORT=3000

# Prisma connection string (backend on host -> localhost; in Docker -> host `postgres`)
DATABASE_URL=postgresql://agency_user:change_me@localhost:5432/agency_management?schema=public

# Auth placeholders for Sprint 1 (dev-only values, NOT real secrets)
JWT_SECRET=change_me_dev_only_not_a_real_secret
JWT_EXPIRES_IN=3600s
