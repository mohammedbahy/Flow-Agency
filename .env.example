# ------------------------------------------------------------------
# Agency Management System — root environment template
# Copy to `.env` and adjust for local development. NEVER commit `.env`.
#   cp .env.example .env
# ------------------------------------------------------------------

# --- PostgreSQL (Docker service `postgres`) ---
POSTGRES_DB=agency_management
POSTGRES_USER=agency_user
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5432

# --- Prisma / Backend database connection ---
# Used by the NestJS backend (Prisma). Host `localhost` when backend runs
# on the host; use host `postgres` when backend runs inside Docker.
DATABASE_URL=postgresql://agency_user:change_me@localhost:5432/agency_management?schema=public

# --- Backend ---
BACKEND_PORT=3000

# --- Frontend ---
# Base URL the React app uses to reach the backend REST API.
FRONTEND_API_URL=http://localhost:3000/api
VITE_API_BASE_URL=http://localhost:3000/api

# --- Auth (Sprint 1 placeholders — no real secrets here) ---
JWT_SECRET=change_me_dev_only_not_a_real_secret
JWT_EXPIRES_IN=3600s
