# Dependencies
node_modules/
.pnp
.pnp.*

# Build outputs
dist/
build/
.next/
out/
*.tsbuildinfo

# Environment files (never commit real secrets)
.env
.env.*
!.env.example
!frontend/.env.example
!backend/.env.example

# Prisma
backend/prisma/migrations/migration_lock.toml
# NOTE: we DO commit migrations/*.sql, but ignore generated client
# (generated client lives in node_modules by default)
backend/generated/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Coverage / test artifacts
coverage/
.nyc_output/
junit*.xml

# OS files
.DS_Store
Thumbs.db

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.classpath
.settings/

# Docker / local data (named volumes are managed by Docker, but ignore local dumps)
*.dump
*.sql.gz
docker/postgres/data/

# Frontend caches
frontend/.vite/
frontend/dist-ssr/

# Misc
*.pem
*.key
tmp/
temp/
